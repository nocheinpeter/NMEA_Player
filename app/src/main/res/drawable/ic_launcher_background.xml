    <path
        android:pathData="M54,10 A44,44 0 1,1 53.99,10 Z"
        android:strokeWidth="0.8"
        android:strokeColor="#2200E5FF"
        android:fillColor="#00000000" />

    <!-- Middle Radar Circle r=32 -->
